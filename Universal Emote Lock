-- [[ LÓGICA DE CONTROLE DE ANIMAÇÕES ]] --
local function updateAnimationSpeeds()
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
        if isPaused then
            track:AdjustSpeed(0)
        else
            track:AdjustSpeed(currentSpeed)
        end
    end
end

local function setupAnimationListener(hum)
    if animConnection then
        animConnection:Disconnect()
        animConnection = nil
    end

    if hum then
        animConnection = hum.AnimationPlayed:Connect(function(track)
            if isPaused then
                track:AdjustSpeed(0)
            else
                track:AdjustSpeed(currentSpeed)
            end
        end)
    end
end

setupAnimationListener(Humanoid)

Player.CharacterAdded:Connect(function(newChar)
    isPaused = false
    currentSpeed = 1
    FreezeBtn.Image = ID_PARALISAR
    Humanoid = newChar:WaitForChild("Humanoid")
    setupAnimationListener(Humanoid)
end)

local function toggleFreeze()
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animateScript = char:FindFirstChild("Animate")
    if not hum then return end

    isPaused = not isPaused

    if isPaused then
        FreezeBtn.Image = ID_DESATIVAR_PARALISACAO
        if animateScript then animateScript.Disabled = true end
    else
        FreezeBtn.Image = ID_PARALISAR
        if animateScript then animateScript.Disabled = false end
    end
    updateAnimationSpeeds()
end

-- [[ CONEXÕES DOS BOTÕES ]] --
FreezeBtn.MouseButton1Click:Connect(toggleFreeze)

SpeedToggleBtn.MouseButton1Click:Connect(function()
    isSpeedMenuVisible = not isSpeedMenuVisible
    SpeedMenu.Visible = isSpeedMenuVisible
    -- A linha só aparece se o menu estiver visível
    ConnectionLine.Visible = isSpeedMenuVisible and isInterfaceVisible
end)

ApplyBtn.MouseButton1Click:Connect(function()
    local val = tonumber(SpeedInput.Text)
    if val then
        currentSpeed = val
        if not isPaused then
            updateAnimationSpeeds()
        end
    end
end)

ResetBtn.MouseButton1Click:Connect(function()
    currentSpeed = 1
    SpeedInput.Text = "1"
    if not isPaused then
        updateAnimationSpeeds()
    end
end)

ExternalToggleBtn.MouseButton1Click:Connect(function()
    local now = tick()
    if now - lastClickExternal < 0.3 then
        local char = Player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local animateScript = char:FindFirstChild("Animate")
            if animateScript then animateScript.Disabled = false end
            if hum then
                for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                    track:AdjustSpeed(1)
                end
            end
        end
        ScreenGui:Destroy()
        return
    end
    lastClickExternal = now

    isInterfaceVisible = not isInterfaceVisible
    MainFrame.Visible = isInterfaceVisible
    
    -- Lógica para esconder a linha se a interface principal sumir
    if not isInterfaceVisible then
        SpeedMenu.Visible = false
        isSpeedMenuVisible = false
        ConnectionLine.Visible = false
    end
end)